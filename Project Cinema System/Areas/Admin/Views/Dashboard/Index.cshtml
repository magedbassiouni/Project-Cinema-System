@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">

    <div class="mb-4">
        <h1>Admin Dashboard</h1>
        <p class="text-muted">Welcome to Cinema System Admin Panel</p>
    </div>

    <div class="row g-4">

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Movies</h4>
                <p>Manage cinema movies.</p>
                <a asp-area="Admin" asp-controller="Movies"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Movies
                </a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Cinemas</h4>
                <p>Manage cinema branches.</p>
                <a asp-area="Admin" asp-controller="Cinemas"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Cinemas
                </a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Actors</h4>
                <p>Manage movie actors.</p>
                <a asp-area="Admin" asp-controller="Actors"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Actors
                </a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Categories</h4>
                <p>Manage movie categories.</p>
                <a asp-area="Admin" asp-controller="Categories"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Categories
                </a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Users</h4>
                <p>Manage user accounts and access.</p>
                <a asp-area="Admin" asp-controller="Users"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Users
                </a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Promotions</h4>
                <p>Manage discount codes and offers.</p>
                <a asp-area="Admin" asp-controller="Promotions"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Promotions
                </a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Showtimes</h4>
                <p>Manage movie schedules and ticket prices.</p>
                <a asp-area="Admin" asp-controller="Showtimes"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Showtimes
                </a>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm h-100 p-3">
                <h4>Bookings</h4>
                <p>View and manage customer bookings.</p>
                <a asp-area="Admin" asp-controller="Bookings"
                   asp-action="Index" class="btn btn-primary mt-auto">
                    Manage Bookings
                </a>
            </div>
        </div>

    </div>
</div>
