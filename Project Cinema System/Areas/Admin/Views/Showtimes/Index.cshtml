@model IEnumerable<Project_Cinema_System.Models.Showtime>

@{
    ViewData["Title"] = "Showtimes Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Showtimes Management</h2>

        <a href="/Admin/Showtimes/Create"
           class="btn btn-primary">
            Add Showtime
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Movie</th>
                    <th>Cinema</th>
                    <th>Date & Time</th>
                    <th>Price</th>
                    <th>Total Tickets</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Movie.Name</td>
                            <td>@item.Cinema.Name</td>
                            <td>
                                @item.DateTime.ToString("dd/MM/yyyy hh:mm tt")
                            </td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@item.TotalTickets</td>
                            <td>@item.Status</td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="Showtimes"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No showtimes found.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>
