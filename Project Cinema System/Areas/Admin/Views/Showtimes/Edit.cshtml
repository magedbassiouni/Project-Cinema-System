@model Project_Cinema_System.ViewModels.Admin.ShowtimeViewModel

@{
    ViewData["Title"] = "Edit Showtime";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="mb-4">Edit Showtime</h2>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="MovieId" class="form-label">Movie</label>
                <select asp-for="MovieId" asp-items="Model.Movies"
                        class="form-select">
                </select>
                <span asp-validation-for="MovieId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CinemaId" class="form-label">Cinema</label>
                <select asp-for="CinemaId" asp-items="Model.Cinemas"
                        class="form-select">
                </select>
                <span asp-validation-for="CinemaId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DateTime" class="form-label"></label>
                <input asp-for="DateTime" type="datetime-local"
                       class="form-control" />
                <span asp-validation-for="DateTime"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" type="number" step="0.01"
                       min="1" class="form-control" />
                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TotalTickets" class="form-label"></label>
                <input asp-for="TotalTickets" type="number"
                       min="1" class="form-control" />
                <span asp-validation-for="TotalTickets"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Scheduled">Scheduled</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="Completed">Completed</option>
                </select>
                <span asp-validation-for="Status"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
