@model Project_Cinema_System.Models.Cinema

@{
    ViewData["Title"] = "Create Cinema";
}

<h1>Add New Cinema</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Img" class="form-label">Image URL</label>
        <input asp-for="Img" class="form-control" placeholder="https://example.com/cinema.jpg" />
        <span asp-validation-for="Img" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Cinema</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
