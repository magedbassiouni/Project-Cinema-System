@model Project_Cinema_System.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<div class="container py-4">
    <h1>Movie Details</h1>

    <div class="card mt-3">
        <div class="row g-0">
            @if (!string.IsNullOrWhiteSpace(Model.MainImg))
            {
                <div class="col-md-4">
                    <img src="@Model.MainImg"
                         alt="@Model.Name"
                         class="img-fluid rounded-start"
                         style="width:100%;height:100%;min-height:250px;object-fit:cover;" />
                </div>
            }

            <div class="col">
                <div class="card-body">
                    <h2 class="card-title">@Model.Name</h2>

                    <p>
                        <strong>Category:</strong>
                        @(Model.Category?.Name ?? "Not specified")
                    </p>

                    <p>
                        <strong>Status:</strong> @Model.Status
                    </p>

                    <p>
                        <strong>Description:</strong>
                    </p>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.Description)
                            ? "No description available."
                            : Model.Description)
                    </p>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Back to Movies
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
