@model Project_Cinema_System.ViewModels.MovieDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
    var poster = Model.ImageUrls.FirstOrDefault();
    var gallery = Model.ImageUrls.Skip(1).ToList();
}

<div class="container my-4">
    <div class="row g-4">

        <!-- البوستر -->
        <div class="col-md-4">
            @if (poster != null)
            {
                <img src="@poster" class="img-fluid rounded shadow" alt="@Model.Name" />
            }
            else
            {
                <div class="border rounded p-5 text-center text-muted">No image available</div>
            }
        </div>

        <!-- المعلومات -->
        <div class="col-md-8">
            <h1 class="mb-2">@Model.Name</h1>

            <p class="text-muted mb-3">
                @(Model.CategoryName ?? "Uncategorized")
                @if (!string.IsNullOrEmpty(Model.CinemaName))
                {
                    <span> | @Model.CinemaName</span>
                }
            </p>

            <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description available." : Model.Description)</p>

            <h5 class="mt-4">Actors</h5>
            <p>
                @if (Model.ActorNames.Any())
                {
                    @string.Join(", ", Model.ActorNames)
                }
                else
                {
                    <span class="text-muted">No actors listed.</span>
                }
            </p>
        </div>
    </div>

    <!-- باقي الصور -->
    @if (gallery.Any())
    {
        <div class="row g-3 mt-3">
            @foreach (var img in gallery)
            {
                <div class="col-6 col-md-3">
                    <img src="@img" class="img-fluid rounded" alt="@Model.Name" />
                </div>
            }
        </div>
    }

    <!-- العروض -->
    <h4 class="mt-5 mb-3">Available Showtimes</h4>

    @if (!Model.Showtimes.Any())
    {
        <div class="alert alert-info">No showtimes available right now.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Cinema</th>
                        <th>Date</th>
                        <th>Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Showtimes)
                    {
                        <tr>
                            <td>@s.CinemaName</td>
                            <td>@s.DateTime.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@s.Price.ToString("N2") EGP</td>
                            <td class="text-end">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-controller="Bookings" asp-action="Create"
                                       asp-route-showtimeId="@s.Id"
                                       class="btn btn-primary btn-sm">Book</a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-outline-secondary btn-sm">Login to book</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>