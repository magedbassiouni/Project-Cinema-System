@model IEnumerable<Project_Cinema_System.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Category</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>

                    <td>
                        <a asp-action="Edit" asp-route-id="@category.Id"
                           class="btn btn-warning">Edit</a>

                        <a asp-action="Delete" asp-route-id="@category.Id"
                           class="btn btn-danger">Delete</a>
                    </td>

               </tr>
        }
    </tbody>
</table>
