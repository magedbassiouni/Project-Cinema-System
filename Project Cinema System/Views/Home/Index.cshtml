@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-2">Cinema Dashboard</h1>
    <p class="text-muted mb-4">
        Welcome to the Cinema Management System
    </p>

    <div class="row g-4">

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Categories</h4>
                    <p>Manage movie categories.</p>
                    <a asp-controller="Category" asp-action="Index"
                       class="btn btn-primary">Manage Categories</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Cinemas</h4>
                    <p>Manage cinema information.</p>
                    <a asp-controller="Cinema" asp-action="Index"
                       class="btn btn-primary">Manage Cinemas</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Movies</h4>
                    <p>Manage movies and their details.</p>
                    <a asp-controller="Movie" asp-action="Index"
                       class="btn btn-primary">Manage Movies</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h4>Actors</h4>
                    <p>Manage actors and their information.</p>
                    <a asp-controller="Actor" asp-action="Index"
                       class="btn btn-primary">Manage Actors</a>
                </div>
            </div>
        </div>

    </div>
</div>
