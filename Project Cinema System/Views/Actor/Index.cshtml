@model IEnumerable<Project_Cinema_System.Models.Actor>

@{
    ViewData["Title"] = "Actors";
}

<h1>Actors</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Actor</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Biography</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var actor in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(actor.Img))
                    {
                        <img src="@actor.Img" alt="@actor.Name"
                             style="width:80px;height:80px;object-fit:cover;" />
                    }
                </td>
                <td>@actor.Name</td>
                <td>@actor.Biography</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@actor.Id"
                       class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@actor.Id"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
