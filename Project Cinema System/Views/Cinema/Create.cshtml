@model Project_Cinema_System.Models.Cinema

@{
    ViewData["Title"] = "Create Cinema";
}

<div class="container mt-4">
    <h1>Create Cinema</h1>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label asp-for="Img" class="form-label">Image URL</label>
            <input asp-for="Img" class="form-control" placeholder="Enter image URL" />
        </div>

        <button type="submit" class="btn btn-primary">Save Cinema</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>
