@model IEnumerable<Project_Cinema_System.Models.Cinema>

@{
    ViewData["Title"] = "Cinemas";
}

<div class="container mt-4">
    <h1>Cinemas</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Add New Cinema</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Address</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cinema in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(cinema.Img))
                        {
                            <img src="@cinema.Img" alt="@cinema.Name"
                                 style="width:80px;height:80px;object-fit:cover;" />
                        }
                    </td>
                    <td>@cinema.Name</td>
                    <td>@cinema.Address</td>
                    <td>@cinema.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@cinema.Id"
                           class="btn btn-warning btn-sm">Edit</a>

                        <a asp-action="Delete" asp-route-id="@cinema.Id"
                           class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
